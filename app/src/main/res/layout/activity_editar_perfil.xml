<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/fondo_logo"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#11000000"/>

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="65dp"
            android:background="#1AFFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp">

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/menu"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Editar perfil"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/imgPerfil"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="5dp"
                android:src="@drawable/perfil"/>

        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/topBar"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#26FFFFFF"
                    android:elevation="8dp"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="20dp"
                        android:text="Mi Perfil"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold"/>

                    <LinearLayout
                        android:id="@+id/btnSeleccionarImagen"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginBottom="20dp"
                        android:background="#1AFFFFFF"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <ImageView
                            android:id="@+id/imgPrevisualizacion"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:scaleType="centerInside"
                            android:src="@android:drawable/ic_menu_camera"/>

                        <TextView
                            android:id="@+id/txtAgregarImagenes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Toca para cambiar foto de perfil"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                    <EditText
                        android:id="@+id/etNombre"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginBottom="15dp"
                        android:background="#33FFFFFF"
                        android:hint=" Nombre"
                        android:padding="15dp"
                        android:text="Sebastian"
                        android:inputType="textPersonName"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#CCCCCC"/>

                    <!-- 💡 OPTIMIZACIÓN: Añadido inputType específico para correo electrónico -->
                    <EditText
                        android:id="@+id/etCorreo"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginBottom="15dp"
                        android:background="#33FFFFFF"
                        android:hint=" Correo"
                        android:padding="15dp"
                        android:text="sebastian@gmail.com"
                        android:inputType="textEmailAddress"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#CCCCCC"/>

                    <!-- 💡 OPTIMIZACIÓN: Añadido inputType específico para teclado numérico telefónico -->
                    <EditText
                        android:id="@+id/etTelefono"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginBottom="15dp"
                        android:background="#33FFFFFF"
                        android:hint=" Teléfono"
                        android:padding="15dp"
                        android:text="3000000000"
                        android:inputType="phone"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#CCCCCC"/>

                    <EditText
                        android:id="@+id/etCiudad"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginBottom="15dp"
                        android:background="#33FFFFFF"
                        android:hint=" Ciudad"
                        android:padding="15dp"
                        android:text="Bogotá"
                        android:inputType="textPostalAddress"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#CCCCCC"/>

                    <!-- 💡 OPTIMIZACIÓN: Configurado para múltiples líneas de texto con scroll vertical independiente -->
                    <EditText
                        android:id="@+id/etDescripcion"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginBottom="20dp"
                        android:background="#33FFFFFF"
                        android:gravity="top"
                        android:hint=" Descripción"
                        android:padding="15dp"
                        android:text="Amante de la tecnología"
                        android:inputType="textMultiLine"
                        android:scrollbars="vertical"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#CCCCCC"/>

                    <Button
                        android:id="@+id/btnGuardar"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:backgroundTint="#0066FF"
                        android:text="Guardar cambios"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"/>

                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </RelativeLayout>

    <!-- MENU LATERAL -->
    <LinearLayout
        android:id="@+id/menuLateral"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#0E1A2B"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtInicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:text="🏠 Inicio"
            android:textColor="#FFFFFF"
            android:textSize="20sp"/>

        <TextView
            android:id="@+id/txtMarketplace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="🛒 Marketplace"
            android:textColor="#FFFFFF"
            android:textSize="20sp"/>

        <TextView
            android:id="@+id/txtProductos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="📦 Publicar"
            android:textColor="#FFFFFF"
            android:textSize="20sp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="15dp"
            android:background="#26FFFFFF"/>

        <TextView
            android:id="@+id/txtCerrarSesion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚪 Cerrar sesión"
            android:textColor="#FF5252"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>